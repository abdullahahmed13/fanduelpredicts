<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/smi_button_focus_background" />
            <corners android:bottomRightRadius="@dimen/smi_bubble_border_radius" />
            <stroke android:width="@dimen/smi_bubble_border_width" android:color="@color/smi_button_border" />
        </shape>
    </item>
    <item android:state_enabled="false" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/smi_button_disabled_selected_background" />
            <corners android:bottomRightRadius="@dimen/smi_bubble_border_radius" />
            <stroke android:width="@dimen/smi_bubble_border_width" android:color="@color/smi_button_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/smi_button_background" />
            <corners android:bottomRightRadius="@dimen/smi_bubble_border_radius" />
            <stroke android:width="@dimen/smi_bubble_border_width" android:color="@color/smi_button_border" />
        </shape>
    </item>
</selector>
