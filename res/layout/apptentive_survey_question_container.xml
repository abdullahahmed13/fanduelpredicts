<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveSurveyScrollViewLayoutStyle"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:id="@id/apptentive_question_layout" android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveSurveyQuestionLayoutStyle">
        <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView android:id="@id/apptentive_question_title" android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveSurveyQuestionTitleStyle" />
            <com.google.android.material.textview.MaterialTextView android:id="@id/apptentive_question_instructions" android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveSurveyQuestionInstructionsStyle" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@id/apptentive_answer_container" android:layout_width="fill_parent" android:layout_height="wrap_content" />
        <com.google.android.material.textview.MaterialTextView android:id="@id/apptentive_question_error_message" android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveSurveyQuestionErrorStyle" />
        <View android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveSurveyQuestionDividerStyle" />
    </LinearLayout>
</ScrollView>
