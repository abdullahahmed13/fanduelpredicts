<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="horizontal" android:id="@id/text_labels_container" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_gravity="bottom" android:orientation="vertical" android:id="@id/min_label_container" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:textAppearance="@style/Formation.TextAppearance.Body.Medium.Regular" android:id="@id/min_value_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_base" />
            <TextView android:textAppearance="@style/Formation.TextAppearance.Label.Small" android:id="@id/min_text_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:gravity="end" android:layout_gravity="bottom" android:orientation="vertical" android:id="@id/max_label_container" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <TextView android:textAppearance="@style/Formation.TextAppearance.Body.Medium.Regular" android:id="@id/max_value_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_base" />
            <TextView android:textAppearance="@style/Formation.TextAppearance.Label.Small" android:id="@id/max_text_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.slider.RangeSlider android:id="@id/range_slider" android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
