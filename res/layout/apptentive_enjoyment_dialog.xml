<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" style="?apptentiveLoveDialogLayoutStyle"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveLoveDialogHeaderImageStyle" />
    <LinearLayout android:layout_width="fill_parent" android:layout_height="wrap_content">
        <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" style="?apptentiveLoveDialogTitleImageStyle" />
        <com.google.android.material.textview.MaterialTextView android:id="@id/apptentive_enjoyment_dialog_title" android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveLoveDialogTitleStyle" />
    </LinearLayout>
    <LinearLayout android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveLoveDialogButtonLayoutStyle">
        <com.google.android.material.button.MaterialButton android:id="@id/apptentive_enjoyment_dialog_no" android:layout_width="wrap_content" android:layout_height="wrap_content" style="?apptentiveLoveDialogNoButtonStyle" />
        <com.google.android.material.button.MaterialButton android:id="@id/apptentive_enjoyment_dialog_yes" android:layout_width="wrap_content" android:layout_height="wrap_content" style="?apptentiveLoveDialogYesButtonStyle" />
    </LinearLayout>
    <LinearLayout android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveLoveDialogButtonLayoutStyleAlternate">
        <com.google.android.material.button.MaterialButton android:id="@id/apptentive_enjoyment_dialog_yes_alternate" android:layout_width="wrap_content" android:layout_height="wrap_content" style="?apptentiveLoveDialogYesButtonStyleAlternate" />
        <com.google.android.material.button.MaterialButton android:id="@id/apptentive_enjoyment_dialog_no_alternate" android:layout_width="wrap_content" android:layout_height="wrap_content" style="?apptentiveLoveDialogNoButtonStyleAlternate" />
    </LinearLayout>
</LinearLayout>
