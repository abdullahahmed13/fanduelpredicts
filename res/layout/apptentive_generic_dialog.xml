<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveGenericDialogLayoutStyle"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <ImageView android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveGenericDialogHeaderImageStyle" />
        <LinearLayout android:layout_width="fill_parent" android:layout_height="wrap_content">
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" style="?apptentiveGenericDialogTitleImageStyle" />
            <com.google.android.material.textview.MaterialTextView android:id="@id/apptentive_generic_dialog_title" android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveGenericDialogTitleTextStyle" />
        </LinearLayout>
        <com.google.android.material.textview.MaterialTextView android:id="@id/apptentive_generic_dialog_message" android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveGenericDialogMessageTextStyle" />
        <LinearLayout android:layout_width="fill_parent" android:layout_height="wrap_content" style="?apptentiveGenericDialogButtonLayoutStyle">
            <com.google.android.material.button.MaterialButton android:id="@id/apptentive_generic_dialog_negative" android:layout_width="wrap_content" android:layout_height="wrap_content" style="?apptentiveGenericDialogNegativeButtonStyle" />
            <com.google.android.material.button.MaterialButton android:id="@id/apptentive_generic_dialog_positive" android:layout_width="wrap_content" android:layout_height="wrap_content" style="?apptentiveGenericDialogPositiveButtonStyle" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
